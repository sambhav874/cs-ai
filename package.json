{
  "name": "@extractor/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "start:frontend": "npm --prefix apps/frontend run start",
    "lint:frontend": "npm --prefix apps/frontend run lint",
    "dev:backend": "cd apps/backend && poetry run uvicorn main:app --reload",
    "start:backend": "cd apps/backend && poetry run uvicorn main:app",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "cy:open": "cypress open --config-file testing/e2e/cypress.config.ts",
    "test:e2e": "cypress run --config-file testing/e2e/cypress.config.ts",
    "test:e2e:dev": "cypress run --config-file testing/e2e/cypress.dev.config.ts",
    "e2e:dev": "npm-run-all --parallel serve:frontend serve:backend:e2e serve:celery:e2e",
    "serve:frontend": "npm --prefix apps/frontend run dev",
    "serve:backend": "cd apps/backend && poetry run uvicorn main:app --reload",
    "serve:backend:e2e": "cd apps/backend && TESTING=true poetry run uvicorn main:app --reload",
    "serve:celery:e2e": "cd apps/backend && TESTING=true poetry run celery -A celery_app worker --loglevel=info -E",
    "serve:frontend-ci": "cd apps/frontend && next dev -p 4200 --turbo ",
    "test:e2e:start-servers": "npm-run-all --parallel --race serve:frontend-ci serve:backend:e2e serve:celery:e2e"
  },
  "private": true,
  "devDependencies": {
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/cypress": "^0.1.6",
    "@types/styled-components": "^5.1.34",
    "cypress": "^14.5.3",
    "depcheck": "^1.4.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2"
  },
  "workspaces": [
    "libs/**",
    "packages/**"
  ],
  "dependencies": {
    "@barba/core": "^2.10.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@stripe/react-stripe-js": "^3.7.0",
    "@stripe/stripe-js": "^7.3.1",
    "chart.js": "^4.5.0",
    "cmdk": "^1.0.4",
    "framer-motion": "^12.7.4",
    "fuse.js": "^7.1.0",
    "gsap": "^3.12.7",
    "next": "^15.1.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "recharts": "^2.15.3",
    "styled-components": "^6.1.17"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}

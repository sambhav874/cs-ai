# ─────────────────────────────────────────────────────────────────────────────
# cs-ai — environment for the lifecycle API (apps/api)
#
#   cp .env.example .env        # .env is gitignored; never commit it
#
# `pnpm --filter api dev` reads THIS file from the repo root
# (tsx --env-file=../../.env). The Python intelligence service has its own:
# see apps/intelligence/.env.template.
#
# Secrets below are deliberately BLANK, not placeholders. In production the API
# refuses to boot on a short or known-placeholder secret (src/lib/secrets.ts),
# so generate each one with the command beside it.
# ─────────────────────────────────────────────────────────────────────────────


# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB: the cluster, with no database name — local, or an Atlas
# mongodb+srv:// string. The API opens its `csai` database on it, ContractSense
# its own. Must be a replica set, even single-node: Prisma refuses transactions
# without one, and change streams need it. Keep the quotes — the & breaks shells.
# DATABASE_URL, if set, still overrides the API's database.
MONGODB_URI="mongodb://localhost:27017/?replicaSet=rs0&directConnection=true"

# BullMQ jobs, rate limiting and the login throttle.
REDIS_URL=redis://localhost:6379

# openssl rand -hex 32   — each must be different
JWT_SECRET=
PORTAL_JWT_SECRET=
INTERNAL_SERVICE_SECRET=

# Where the web app is served. Used in emails and signer-portal links; without
# it those links point nowhere (one of draftLegal's upstream self-host bugs).
FRONTEND_URL=http://localhost:5173


# ── Server ───────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001
# HOST=0.0.0.0
# LOG_LEVEL=info
# Comma-separated, in addition to FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=
# API_URL=http://localhost:3001
# WEB_BASE_URL=http://localhost:5173
# GIT_COMMIT_SHA=


# ── Auth ─────────────────────────────────────────────────────────────────────

# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# Encrypts each org's bring-your-own LLM keys at rest. Required once any org
# stores a key. Set it ONCE and never change it: rotating it makes every stored
# key undecryptable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_KEY_ENCRYPTION_KEY=


# ── Database tuning ──────────────────────────────────────────────────────────

# Appended to the URL as maxPoolSize on MongoDB (connection_limit on Postgres).
# PRISMA_POOL_LIMIT=20
# Queries slower than this are logged at warn.
# SLOW_QUERY_MS=250


# ── File storage (S3 interface — MinIO for self-host, S3 / Azure Blob in SaaS) ─

# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=clm-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION are read as fallbacks.


# ── Email — required for e-signature and reminders ───────────────────────────
#
# draftLegal sends NOTHING without one of these, so signer invitations and
# obligation reminders silently never arrive. Use SMTP or SendGrid.

# To try email with no provider on a self-host: start the catcher with
#   docker compose --profile mail-test up -d mailpit
# and set SMTP_HOST=mailpit SMTP_PORT=1025 (inbox at http://localhost:8025).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SENDGRID_API_KEY=
# Sender address. SMTP_FROM wins; EMAIL_FROM is read as a fallback.
# SMTP_FROM=noreply@example.com
# EMAIL_FROM=

# Inbound email intake (Phase 2).
# INBOUND_EMAIL_DOMAIN=
# INBOUND_EMAIL_SECRET=
# INBOUND_EMAIL_ALLOW_ALL=0


# ── E-signature ──────────────────────────────────────────────────────────────

# PAdES seal: a P12 certificate, base64-encoded, and its passphrase.
#   base64 -i your-cert.p12 | tr -d '\n'
# SIGNING_CERT_P12_BASE64=
# SIGNING_CERT_PASSPHRASE=

# HTML → PDF before sealing. OPTIONAL: only needed if this deployment signs
# documents natively. Upload-and-track (path 2) and DocuSign users can omit it.
# GOTENBERG_URL=http://localhost:3002
# GOTENBERG_REQUIRE_AUTH=false


# ── AI providers ─────────────────────────────────────────────────────────────
#
# All optional. With none set the app boots and every non-AI feature works;
# AI features return 503 until a key exists. Orgs can also bring their own
# keys in-app (encrypted with AI_KEY_ENCRYPTION_KEY above).

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# Voyage embeddings for contract Q&A: a dash.voyageai.com key, or a MongoDB
# Atlas model API key (the client routes it to ai.mongodb.com by itself).
# VOYAGE_API_KEY=

# Platform-wide daily LLM spend cap, in USD.
# PLATFORM_DAILY_COST_CAP_USD=50

# draftLegal's agents service. Temporary: being harvested into
# apps/intelligence and then removed.
# AGENTS_URL=http://localhost:8000/agents


# ── Background work ──────────────────────────────────────────────────────────

# WORKERS_ENABLED=true
# RENEWAL_SCAN_PATTERN=15 9 * * *
# OBLIGATION_SCAN_PATTERN=0 9 * * *

# Real-time co-editing (Hocuspocus). 1 disables it.
# COLLAB_DISABLED=0
# COLLAB_PORT=3030


# ── Security switches — leave these alone unless you know why ────────────────

# Allows webhooks to target private / loopback addresses. Off by default because
# it turns the webhook sender into an SSRF tool against your own network.
# WEBHOOK_ALLOW_PRIVATE_URLS=false


# ── Being removed ────────────────────────────────────────────────────────────

# Elasticsearch is dropped in the merged stack (retrieval moves to Atlas Search
# / Mongo text + Qdrant). The API logs a warning and degrades if it is absent.
# ELASTICSEARCH_URL=http://localhost:9200


# ── Seeding demo data (pnpm --filter api db:seed) ────────────────────────────

# Unset: a random password is generated and printed once, on first seed only.
# Set (12+ chars): used for the demo users, and resets them if they exist.
# SEED_ADMIN_PASSWORD=
# The seed refuses NODE_ENV=production unless this is 1.
# SEED_ALLOW_PRODUCTION=0

# Keep the build context small: every image build ships this directory to the
# builder, and node_modules alone is ~1GB.
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
.git
.github
.pytest_cache
.claude
# Local secrets, at any depth. A bare `.env` matches only the repository root,
# so apps/intelligence/.env — a developer's keys and PLATFORM_JWT_SECRET — was
# copied into every locally built image, where it overrode the deployment's
# own secrets and shipped with any image that was pushed.
**/.env
**/.env.*
!**/.env.example
!**/.env.template
vendor
testing
final_evaluation
docs
**/.DS_Store
**/coverage
**/.turbo

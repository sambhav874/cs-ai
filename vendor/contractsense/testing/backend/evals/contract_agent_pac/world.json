          "ref": "airport-food-master#parties",
          "title": "Parties and Scope",
          "text": "Terminal Authority appoints Global Air Caterers LLC as the exclusive provider for hot meal loading, chilled snack stocking, and emergency catering support at Terminal 4."
        },
        {
          "ref": "airport-food-master#ops-contact",
          "title": "Operational Contact",
          "text": "The primary operational contact for the airport food project is Dana Rao, Terminal Authority Program Manager, dana.rao@example.test."
        },
        {
          "ref": "airport-food-master#sla-hot-meals",
          "title": "Service Level - Hot Meal Response",
          "text": "Global Air Caterers must deliver approved hot meal requests to the assigned gate within 15 minutes after dispatch acknowledgement for at least 98% of measured requests in each calendar month."
        },
        {
          "ref": "airport-food-master#service-credit",
          "title": "Service Credit",
          "text": "If monthly hot meal response performance falls below 98%, Terminal Authority may apply a service credit equal to 2% of the affected monthly invoice and require a written cure plan within 5 business days."
        },
        {
          "ref": "airport-food-master#payment",
          "title": "Payment Terms",
          "text": "Invoices are payable net 30 days after receipt of a correct invoice. Undisputed late balances accrue interest at 1.5% per month."
        },
        {
          "ref": "airport-food-master#confidentiality",
          "title": "Confidentiality",
          "text": "Rate cards, renewal caps, passenger volume forecasts, and operating procedures are confidential and must not be disclosed to vendors or third parties unless the agreement expressly authorizes disclosure."
        }
      ]

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cs/*": ["./src/features/intelligence/*"],
      "next/link": ["./src/features/intelligence/shims/next-link.tsx"],
      "next/navigation": ["./src/features/intelligence/shims/next-navigation.ts"],
      "next/dynamic": ["./src/features/intelligence/shims/next-dynamic.tsx"],
      "next/image": ["./src/features/intelligence/shims/next-image.tsx"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

# ================================================
# Stage 1: Install dependencies (prod + dev)
# ================================================
FROM node:20-alpine AS deps
WORKDIR /app
# Install system dependencies (needed for some npm packages)
RUN apk add --no-cache libc6-compat
# Copy only what's needed for dependency installation
COPY package.json package-lock.json ./
# Install all dependencies (including devDependencies)
RUN npm ci --legacy-peer-deps

# ================================================
# Stage 2: Build the application
# ================================================
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependencies from previous stage
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Set build-time environment variables (will be baked into the build)
ARG NODE_ENV=production
ARG NEXT_PUBLIC_EXTRACTOR_API_URL=http://134.33.215.56:8001/api/v1
ARG NEXT_PUBLIC_API_URL=http://20.185.210.243
ARG NEXT_PORT=4201

ENV NODE_ENV=${NODE_ENV}
ENV NEXT_PUBLIC_EXTRACTOR_API_URL=${NEXT_PUBLIC_EXTRACTOR_API_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV PORT=${NEXT_PORT}

# Build Next.js (this bakes the public variables into static files)
RUN npm run build

# ================================================
# Stage 3: Production image
# ================================================
FROM node:20-alpine AS production
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -u 1001 -S nextjs -G nodejs

# Copy built assets (including the baked-in environment variables)
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Runtime environment variables (only non-NEXT_PUBLIC variables need to be set here)
ENV NODE_ENV=production
ENV PORT=3000

USER nextjs
EXPOSE ${PORT}
CMD ["npm", "start"]

# ================================================
# Stage 4: Development image (optional)
# ================================================
FROM node:20-alpine AS development
WORKDIR /app
# Copy package files first for better caching
COPY package.json package-lock.json ./
# Install all dependencies (including devDependencies)
RUN npm install --legacy-peer-deps
# Copy source code
COPY . .

# Hardcoded environment variables for development
ENV NODE_ENV=development
ENV NEXT_PUBLIC_EXTRACTOR_API_URL=http://localhost:8000/api/v1
ENV NEXT_PUBLIC_API_URL=http://localhost:4200/
ENV PORT=4200
ENV NEXT_PORT=4200

EXPOSE 4200
CMD ["npm", "run", "dev"]
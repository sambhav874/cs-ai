# ============================================================
# ContractSense — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Required fields are marked with [REQUIRED].

# ── API Configuration ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_TIMEOUT=300
DOMAIN=http://localhost:4200

# ── Security ────────────────────────────────────────────────
SECRET_KEY=[REQUIRED]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:4200

# ── Database ────────────────────────────────────────────────
MONGODB_URI=[REQUIRED]
MONGODB_DB_NAME=contract_analysis
MONGODB_COLLECTION_NAME=contract_vectors
MONGODB_VECTOR_INDEX_NAME=vector_index
USE_MONGODB_VECTOR=true

# ── LLM: Groq ───────────────────────────────────────────────
GROQ_API_KEY=[REQUIRED]
GROQ_STRICT_MODE=false

# ── LLM: Anthropic ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-20241022
CLAUDE_MODEL_NAME=claude-3-5-haiku-20241022
CLAUDE_STRICT_MODE=false

# ── LLM: Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash

# ── LLM: OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4-turbo-preview

# ── Embeddings: VoyageAI ────────────────────────────────────
VOYAGEAI_API_KEY=
VOYAGEAI_MODEL_NAME=voyage-law-2
VOYAGEAI_EMBEDDING_DIMENSION=1024

# ── Reranker (VoyageAI) ─────────────────────────────────────
VOYAGE_RERANK_ENABLED=false
VOYAGE_RERANK_MODEL=rerank-2-lite
VOYAGE_RERANK_TOP_K=20
VOYAGE_RERANK_FINAL_K=8

# ── Embeddings: OpenAI ──────────────────────────────────────
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536

# ── Embeddings: HuggingFace ─────────────────────────────────
HUGGINGFACE_TOKEN=[REQUIRED]
EMBEDDINGS_MODEL_NAME=intfloat/e5-large-v2

# ── Pinecone Vector DB ──────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
CLEANUP_PINECONE_NAMESPACE=true

# ── Model Config ────────────────────────────────────────────
MODEL_NAME=llama-3.1-8b-instant
USE_GPU=false
MAX_TOKENS=2048
TEMPERATURE=0.1
TOP_P=0.95
FREQUENCY_PENALTY=1.15
N=1
MODEL_CONTEXT_WINDOW=8192
PROMPT_OVERHEAD_ESTIMATE=2500

# ── Retrieval / Chunking ────────────────────────────────────
THREAD_POOL_WORKERS=4
CHUNK_SIZE=4000
CHUNK_OVERLAP=200
CHUNK_SCHEMA_VERSION=2
RETRIEVER_CANDIDATE_K=32
RETRIEVER_FINAL_K=14
MAX_SEGMENTS_IN_PROMPT=18
RETRIEVER_CONTEXT_CHAR_BUDGET=12000
RETRIEVER_SEGMENT_EXCERPT_CHARS=1200
LEGAL_MESO_MIN_CHARS=1200
LEGAL_MESO_MAX_CHARS=3000
LEGAL_MACRO_MAX_CHARS=2600
LEGAL_MICRO_CONTEXT_CHARS=420

# ── Query Decomposition ─────────────────────────────────────
QUERY_DECOMPOSITION_ENABLED=false
QUERY_DECOMPOSITION_MAX_SUBQUERIES=4

# ── Celery / Task Queue ─────────────────────────────────────
# Redis, shared with the lifecycle tier's BullMQ under separate key prefixes.
# Required — there is no default broker, by design.
CELERY_BROKER_URL=redis://localhost:6379/0
# Optional. Unset means results go to MONGODB_URI, which every process and
# replica can read. Do not use rpc:// — results become invisible to any
# process other than the one that enqueued the task.
# CELERY_RESULT_BACKEND=

# ── Azure Service Bus (alternative broker) ──────────────────
SERVICE_BUS_SAS_POLICY_NAME=
SERVICE_BUS_SAS_KEY=
SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_CONNECTION_STRING=

# ── Azure Communication Services (email) ────────────────────
AZURE_COMMUNICATION_CONNECTION_STRING=[REQUIRED]
AZURE_SENDER_ADDRESS=[REQUIRED]
SUPPORT_EMAIL_ADDRESS=[REQUIRED]

# ── Google Analytics 4 ─────────────────────────────────────
GA_MEASUREMENT_ID=
GA_API_SECRET=

# ── Marker PDF API ──────────────────────────────────────────
MARKER_API_KEY=
MARKER_API_URL=https://www.datalab.to/api/v1/marker

# ── Environment ─────────────────────────────────────────────
APP_ENV=development
TESTING=false
